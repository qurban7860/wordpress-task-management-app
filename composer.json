{
  "name": "trickleup/task-management-app",
  "description": "WordPress task management plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "TMA\\TaskManagement\\": "includes/"
    }
  },
  "scripts": {
    "lint": "php -l task-management-app.php && find includes -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "phpunit --configuration phpunit.xml.dist"
  }
}
